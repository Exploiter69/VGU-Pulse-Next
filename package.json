{
  "name": "vgu-pulse-next",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply vgu-pulse-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vgu-pulse-db --remote",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.5",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2",
    "vite": "^6.2.6",
    "vitest": "^3.1.1",
    "wrangler": "^4.4.0"
  },
  "overrides": {
    "esbuild": "^0.25.2"
  }
}
