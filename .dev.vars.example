# Copy this file to .dev.vars for local Cloudflare Worker development:
# cp .dev.vars.example .dev.vars

APP_ENV="development"
PUBLIC_ORIGIN="http://localhost:5173"

# Cloudflare Official Dummy Test Keys (Always Passes in Local Development)
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Local Salt used to hash client IP addresses before rate-limit storage
RATE_LIMIT_SALT="local-dev-non-secret-salt-change-in-prod"
